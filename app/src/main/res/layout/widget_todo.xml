<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_surface"
    android:orientation="vertical" android:padding="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/w_accent" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08" android:maxLines="1" />
        <TextView android:id="@+id/w_action" android:layout_width="wrap_content" android:layout_height="28dp" android:paddingHorizontal="12dp"
            android:background="@drawable/w_accent_pill" android:gravity="center" android:textColor="@color/w_on_accent" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_sub" android:textSize="13sp" android:layout_marginTop="2dp" android:layout_marginBottom="4dp"/>
    <LinearLayout android:id="@+id/w_row0" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_check0" android:layout_width="22dp" android:layout_height="22dp" android:gravity="center"
            android:background="@drawable/w_chip" android:textColor="@color/w_accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_task0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_text" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_check1" android:layout_width="22dp" android:layout_height="22dp" android:gravity="center"
            android:background="@drawable/w_chip" android:textColor="@color/w_accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_task1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_text" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_check2" android:layout_width="22dp" android:layout_height="22dp" android:gravity="center"
            android:background="@drawable/w_chip" android:textColor="@color/w_accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_task2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_text" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_check3" android:layout_width="22dp" android:layout_height="22dp" android:gravity="center"
            android:background="@drawable/w_chip" android:textColor="@color/w_accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_task3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_text" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row4" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_check4" android:layout_width="22dp" android:layout_height="22dp" android:gravity="center"
            android:background="@drawable/w_chip" android:textColor="@color/w_accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_task4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/w_text" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
