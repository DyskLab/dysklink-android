<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_surface"
    android:orientation="vertical" android:padding="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/w_accent" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08" android:maxLines="1" />
        <TextView android:id="@+id/w_action" android:layout_width="wrap_content" android:layout_height="28dp" android:paddingHorizontal="12dp"
            android:background="@drawable/w_accent_pill" android:gravity="center" android:textColor="@color/w_on_accent" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <Chronometer android:id="@+id/w_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_text" android:textSize="34sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_phase" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_sub" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_water" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_text" android:textSize="22sp" android:textStyle="bold" android:gravity="end"/>
            <TextView android:id="@+id/w_water_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_sub" android:textSize="12sp" android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_btn1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginHorizontal="3dp" android:background="@drawable/w_accent_pill" android:gravity="center" android:maxLines="2" android:ellipsize="end"
            android:paddingHorizontal="6dp" android:textColor="@color/w_on_accent" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_btn2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginHorizontal="3dp" android:background="@drawable/w_chip" android:gravity="center" android:maxLines="2" android:ellipsize="end"
            android:paddingHorizontal="6dp" android:textColor="@color/w_text" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
